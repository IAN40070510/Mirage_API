# 明確選擇領域；.env 不會自動載入，請由管理者或部署工具設定環境變數。
MIRAGE_DOMAIN=ecommerce
MIRAGE_APP_CONFIG=configs/app.yaml
MIRAGE_DOMAINS_DIR=domains
# 若未覆寫下列路徑，識別／契約入口使用所選領域 manifest 指定的位置。
# MIRAGE_PLATFORMS_DIR=domains/ecommerce/inputs/platforms
# MIRAGE_BINDINGS_FILE=domains/ecommerce/configs/bindings.yaml
# 可信 runtime context 必須三個一起設定，供僅平台識別入口使用。
# MIRAGE_ENVIRONMENT_ID=local-test
# MIRAGE_DEPLOYMENT_ID=medusa-demo
# MIRAGE_SERVICE_ID=storefront
