# 複製為版本庫外、權限受限的部署環境設定；這裡只有非機密識別與檔案目錄。
# MIRAGE_SINGLE_NODE_IMAGE 為已審查建置的 Runtime Image；正式釋出需固定 digest。
MIRAGE_SINGLE_NODE_IMAGE=mirage-api:standalone
MIRAGE_SINGLE_NODE_POSTGRES_IMAGE=postgres:17.6-alpine
MIRAGE_SINGLE_NODE_SECRETS_DIR=/srv/mirage/single-node/secrets
MIRAGE_SINGLE_NODE_DB_NAME=mirage
MIRAGE_SINGLE_NODE_DB_ADMIN=mirage_admin
# Current Migration/role preflight uses the public schema; changing this requires an explicit schema migration.
MIRAGE_SINGLE_NODE_WORLD_SCHEMA=public
MIRAGE_SINGLE_NODE_ENVIRONMENT_ID=mirage-local
MIRAGE_SINGLE_NODE_DEPLOYMENT_ID=replace-with-unique-deployment-id
MIRAGE_SINGLE_NODE_ISSUER=replace-with-real-issuer
MIRAGE_SINGLE_NODE_AUDIENCE=replace-with-real-audience
MIRAGE_SINGLE_NODE_VERIFIER_LOGIN=mirage_verifier
MIRAGE_SINGLE_NODE_INVENTORY_LOGIN=mirage_inventory_executor
MIRAGE_SINGLE_NODE_CART_LOGIN=mirage_cart_executor
MIRAGE_SINGLE_NODE_VALIDATOR_LOGIN=mirage_validator
MIRAGE_SINGLE_NODE_PUBLISHER_READER_LOGIN=mirage_publisher_reader
MIRAGE_SINGLE_NODE_PUBLISHER_WRITER_LOGIN=mirage_publisher_writer
MIRAGE_SINGLE_NODE_PUBLISHER_PROMOTER_LOGIN=mirage_publisher_promoter
MIRAGE_SINGLE_NODE_AUTHORIZER_LOGIN=mirage_authorizer
MIRAGE_SINGLE_NODE_SENDER_LOGIN=mirage_sender
MIRAGE_SINGLE_NODE_GATEWAY_LOCAL_PORT=18443
