# 契約以原始 bytes 計算 SHA-256，避免 Git 在不同作業系統改寫換行。
inputs/sources/**/openapi.yaml -text
inputs/platforms/**/openapi.yaml -text
# 領域包搬移後仍須保留契約原始 bytes，否則 Windows checkout 會改變 SHA-256。
domains/**/inputs/sources/**/openapi.yaml -text
domains/**/inputs/platforms/**/openapi.yaml -text
# 授權原文與歸屬聲明以 LF 保存，方便跨平台核對。
LICENSE text eol=lf
NOTICE text eol=lf
licenses/*.txt text eol=lf
